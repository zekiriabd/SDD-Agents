# GÉNÉRÉ par gen_app_skeleton.py — ne pas éditer à la main.
#
# Les dépendances sont DÉRIVÉES par le générateur des `.libs.json` des fiches
# ACTIVES de STACK.md (`core`, `dev`, `onDemand` déclenchés) et du SDK du
# fournisseur runtime (`runtime_sdk` de sa fiche `.sdda/providers/`), épinglées
# `==` sur la version du catalogue — la seule qui fasse foi. `dependencies = []`
# laissait un projet « vert » qui ne s'installait pas. Un paquet ajouté à la main
# (`uv add`) est conservé à la régénération ; un paquet dérivé est ramené à sa
# version de catalogue.

[project]
name = "{AppName}"
version = "0.1.0"
description = "{AppName} — application agentic générée par SDD_Agents."
requires-python = ">=3.12"
dependencies = {Dependencies}

# Le livrable par défaut est `cli-exe` : un programme qu'on lance, une entrée,
# une sortie, un code de retour. C'est aussi la surface que le runner d'eval
# invoque en L5/L7 — donc ce qu'on mesure est ce qu'on livre.
[project.scripts]
{AppName} = "{AppName}.serving.cli:main"

# Les outils d'ATELIER (tests, lint, typage), et eux seuls : ils ne partent pas
# dans la roue. `ruff`/`mypy` des catalogues atterrissent ici, pas en dépendance
# d'exécution. `asyncio_mode = "auto"` (plus bas) ne vaut rien sans
# pytest-asyncio — sans lui, chaque test `async def` échoue en « async def
# functions are not natively supported », ce qui ressemble à une panne du code.
[dependency-groups]
dev = {DevDependencies}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

# Layout PLAT (convention SDD_Pro) : ce répertoire EST le paquet `{AppName}`.
# Dans la roue, la racine du projet est réécrite en `{AppName}/` ; ce qui n'est
# pas du code livrable (tests, secrets, méta du projet) n'y entre pas.
[tool.hatch.build.targets.wheel]
only-include = ["."]
exclude = ["**/tests", ".env", ".env.example", "README.md", "pyproject.toml", "uv.lock", "__pycache__"]

[tool.hatch.build.targets.wheel.sources]
"" = "{AppName}"

# Installation éditable (`uv sync`, `pip install -e`) : hatchling refuse de
# réécrire le préfixe `""` en mode dev. On expose le répertoire PARENT sur
# sys.path, où `{AppName}/` est un paquet importable tel quel.
[tool.hatch.build.targets.wheel.force-include]

[tool.hatch.build]
dev-mode-dirs = [".."]

[tool.ruff]
line-length = 110
target-version = "py312"

[tool.ruff.lint]
# `T20` (print) : la sortie machine passe par `sys.stdout.write` en NDJSON, et
# le diagnostic par `stderr`. Un `print` égaré casse le contrat `--json`.
select = ["E", "F", "I", "B", "ASYNC", "S", "T20"]

[tool.ruff.lint.per-file-ignores]
# `assert` est l'outil de pytest ; S101 ne vaut que pour le code livré.
"**/tests/**" = ["S101"]

[tool.mypy]
strict = true
python_version = "3.12"

# Dépendances OPTIONNELLES, importées paresseusement : le fournisseur de modèle
# qu'on n'utilise pas (`anthropic`), les formats de fichier qu'on n'a pas
# (`openpyxl`, `pyarrow`). Absentes, elles ne sont pas une erreur de type.
[[tool.mypy.overrides]]
module = ["anthropic", "anthropic.*", "openai", "openai.*", "openpyxl", "openpyxl.*", "pyarrow", "pyarrow.*"]
ignore_missing_imports = true

[tool.pytest.ini_options]
asyncio_mode = "auto"
# Layout plat : les tests vivent À CÔTÉ de ce qu'ils testent (`app/tests`,
# `tools/tests`…), il n'y a pas de `tests/` racine à désigner.
testpaths = ["."]
markers = [
  "network: exige une dépendance joignable ; exclu du smoke",
  "eval: suite d'évaluation (k runs) ; jamais relancée sur échec — cela masquerait la variance",
]
