SourceAgentRole: readonly             # readonly — seule valeur admise sur cette stack
SourceReadTimeoutMs: 5000             # budget de lecture+filtrage d'UN appel d'outil
SourceMaxRecordsReturned: 200         # on lit maxRows+1 -> truncated: true
SourceMaxObjectBytes: 52428800        # 50 Mo — fichier ou réponse d'API plus gros : refusé
SourceSchemaCheckSample: 500          # enregistrements revalidés contre le schéma figé au boot
SourceMaxStalenessHours: 24           # au-delà -> erreur SOURCE_STALE, pas un log
